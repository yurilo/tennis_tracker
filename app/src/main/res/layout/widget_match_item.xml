<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_match_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_item_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Match Info & Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/txt_item_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Men's Singles • Arthur Ashe Stadium"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <!-- Live Status Badge -->
        <TextView
            android:id="@+id/txt_item_status_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_live"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="LIVE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Final Status Badge -->
        <TextView
            android:id="@+id/txt_item_status_final"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_final"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="FINAL"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Upcoming Status Badge -->
        <TextView
            android:id="@+id/txt_item_status_upcoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_upcoming"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="UPCOMING"
            android:textColor="#93C5FD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Player 1 Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/txt_player1_serve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎾"
            android:textSize="11sp"
            android:paddingEnd="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_player1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🇪🇸 C. Alcaraz [1]"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_player1_scores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6   4   6"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingRight="8dp" />

        <TextView
            android:id="@+id/txt_player1_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_game_pill"
            android:gravity="center"
            android:minWidth="28dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="40"
            android:textColor="#93C5FD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_player1_game_serving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_game_pill_serving"
            android:gravity="center"
            android:minWidth="34dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="● 40"
            android:textColor="#CCFF00"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Player 2 Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/txt_player2_serve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎾"
            android:textSize="11sp"
            android:paddingEnd="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_player2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🇮🇹 J. Sinner [2]"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_player2_scores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4   6   3"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingRight="8dp" />

        <TextView
            android:id="@+id/txt_player2_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_game_pill"
            android:gravity="center"
            android:minWidth="28dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="30"
            android:textColor="#93C5FD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_player2_game_serving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_game_pill_serving"
            android:gravity="center"
            android:minWidth="34dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="● 30"
            android:textColor="#CCFF00"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
